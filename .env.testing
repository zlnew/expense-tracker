# Test environment — ALWAYS sqlite :memory:, never a real database.
# Incident 2026-08-03: tests ran against the real pgsql DB via leaked env
# vars and RefreshDatabase wiped it. This file + the TestCase guard force
# sqlite so that can never happen again.
APP_ENV=testing
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
