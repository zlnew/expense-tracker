# Playwright e2e stack env (tests/e2e/scripts/e2e-server.sh sets APP_ENV=e2e).
#
# Why this file exists: `php artisan serve` strips non-passthrough env vars
# (APP_KEY, SESSION_DRIVER, ...) from its PHP server workers whenever a .env
# exists, and LoadEnvironmentVariables redirects dotenv to .env.{APP_ENV}.
# With APP_ENV=testing the worker therefore booted from .env.testing — which
# is deliberately key-less (pest safety file) — and every page 500'd with
# MissingAppKeyException. Giving the e2e stack its own APP_ENV makes the
# worker load THIS file instead; pest/phpunit keep using .env.testing +
# phpunit.xml and are unaffected.
#
# Values mirror the exports in tests/e2e/scripts/e2e-server.sh (which remain
# in place for the migrate/seed subprocesses and the host-PHP branch).
APP_NAME="Expense Tracker (e2e)"
APP_ENV=e2e
APP_KEY=base64:xRQ9Yq5vTn3wK2mB8sLcH0jE6uPdA1gZ4iN7oVfCyWk=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8015
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=database
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=log

BCRYPT_ROUNDS=4
